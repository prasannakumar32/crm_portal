# MongoDB Connection Setup Guide
# ================================

# 1. SRV CONNECTION STRING (Recommended - supports MongoDB Atlas)
# Copy from MongoDB Atlas: Clusters > Connect > Drivers > Connection String
# Replace <USERNAME> with your Database User from MongoDB Atlas
# Replace <PASSWORD> with that user's password
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.aykrv4v.mongodb.net/crm_portal?retryWrites=true&w=majority&appName=Cluster0

# 2. FALLBACK CONNECTION STRING (Standard format - use if SRV fails)
# Copy from MongoDB Atlas: Clusters > Connect > Drivers > Standard Connection String
# Replace <USERNAME> and <PASSWORD> with your MongoDB user credentials
MONGO_URI_FALLBACK=mongodb://<USERNAME>:<PASSWORD>@ac-iwhf30q-shard-00-00.aykrv4v.mongodb.net:27017,ac-iwhf30q-shard-00-01.aykrv4v.mongodb.net:27017,ac-iwhf30q-shard-00-02.aykrv4v.mongodb.net:27017/crm_portal?ssl=true&replicaSet=atlas-iwhf30q-shard-0&authSource=admin&retryWrites=true&w=majority

# 3. Database Name (matches your MongoDB database)
MONGO_DB_NAME=crm_portal

# 4. Session Secret (IMPORTANT: Change this for production!)
# Generate a secure random string with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secure-session-secret-change-this-in-production

# 5. Server Configuration
PORT=3333

# ================================
# SETUP INSTRUCTIONS:
# ================================
# 1. Create a MongoDB Atlas account: https://www.mongodb.com/cloud/atlas
# 2. Create a cluster
# 3. Create a Database User:
#    - Go to: Database → Database Users → Add New Database User
#    - Use username: crm_user (or your preferred username)
#    - Generate a secure password
#    - Set Database User Privileges: Built-in role: Atlas admin (for development only)
# 4. Copy your connection string from: Clusters > Connect > Drivers
# 5. Replace <USERNAME> and <PASSWORD> in MONGO_URI above
# 6. Ensure your IP is whitelisted:
#    - Go to: Network Access → IP Access List
#    - Add your IP address or allow 0.0.0.0/0 for development
# 7. Save this file as .env in the project root
# 8. Start the server: npm start
#
# SECURITY NOTES:
# - Never commit .env to version control (it's in .gitignore)
# - Never share credentials in pull requests or issues
# - Use strong passwords for production databases
# - Rotate credentials regularly
# - Use IP whitelisting in production
