# Supabase Connection Setup Guide
# ================================

# For Local Development:
# 1. SUPABASE_URL - Your Supabase project URL
# Copy from Supabase: Project Settings → API → Project URL
SUPABASE_URL=https://qijolfnxazrimboqkwqa.supabase.co

# 2. SUPABASE_SERVICE_ROLE_KEY - Service Role Key (bypasses RLS)
# Copy from Supabase: Project Settings → API → service_role (secret)
# WARNING: This key has full access to your database - keep it secret!
# NOTE: You provided a publishable key, but the backend needs the service_role key
# Get the service_role key from: Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Session Secret (IMPORTANT: Change this for production!)
# Generate a secure random string with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secure-session-secret-change-this-in-production

# 4. Server Configuration
PORT=3333

# ================================
# LOCAL SETUP INSTRUCTIONS:
# ================================
# 1. Create a Supabase account: https://supabase.com
# 2. Create a new project
# 3. Go to Project Settings → API
# 4. Copy the Project URL and Service Role Key
# 5. Replace the values in SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above
# 6. Run the SQL schema in supabase-schema.sql to create database tables:
#    - Open Supabase SQL Editor
#    - Copy and paste the contents of supabase-schema.sql
#    - Run the SQL to create all tables and indexes
# 7. Save this file as .env in the project root
# 8. Start the server: npm start
#
# SECURITY NOTES:
# - Never commit .env to version control (it's in .gitignore)
# - Never share credentials in pull requests or issues
# - Use strong secrets for production
# - Rotate credentials regularly
# - The Service Role Key bypasses Row Level Security - use with caution
